# Copy this file to `.env` in the repository root and fill in real values.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `.env` is git-ignored — never commit real credentials.

# PostgreSQL connection string used by SQLAlchemy (chat_backend/database.py)
# and by Alembic (alembic/env.py).
# Supabase pooler example (note: the password is part of the userinfo section):
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Local PostgreSQL example (remove `connect_args={"sslmode": "require"}` in database.py):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_analyzer

# Key used to sign JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# Token lifetime in minutes (declared in .env/render.yaml; the code currently
# uses a hard-coded 30-minute constant — see gap B6 in docs/GAPS_AND_IMPROVEMENTS.md).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API base URL for the SPA. Vite only reads env files placed in chat_frontend/,
# so also copy this line into chat_frontend/.env for it to take effect.
VITE_API_URL=http://127.0.0.1:8000/
