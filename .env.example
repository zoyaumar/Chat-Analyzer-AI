# Copy this file to `.env` in the repository root and fill in real values.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# `.env` is git-ignored — never commit real credentials.

# Async PostgreSQL connection string used by SQLAlchemy and Alembic
# (chat_backend/config.py reads it for both).
# Local Compose:     postgresql+asyncpg://chat:chat@db:5432/chat_analyzer
DATABASE_URL=postgresql+asyncpg://chat:chat@db:5432/chat_analyzer

# Key used to sign JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# Token lifetime in minutes (read through chat_backend/config.py).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Credential rate limits, per client address (gap S6). Counted in-process, so
# these are per uvicorn worker; leave them unset unless you need a different
# policy from the defaults. Login is the brute-force surface, registration the
# spam surface.
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SECONDS=300
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_SECONDS=3600
